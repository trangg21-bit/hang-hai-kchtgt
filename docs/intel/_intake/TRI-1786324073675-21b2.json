  "entry_point": "DataScopeAspect calls session.enableFilter(\"orgUnitFilter\") but entities missing @Filter annotation cause Hibernate to ignore the filter, exposing all data regardless of org unit",
  "blast_radius": 9,
  "done_oracle": "mvn test passes; every entity with orgUnitId field has @org.hibernate.annotations.Filter(name = \"orgUnitFilter\", condition = \"org_unit_id IN (:orgUnitIds)\")",
  "change_type": "hotfix",
  "seam_claims": [
    {
      "file": "src/main/java/com/hanghai/kchtg/common/entity/BaseEntity.java",
      "line": 35,
      "quote": "@org.hibernate.annotations.FilterDef(\n        name = \"orgUnitFilter\",\n        parameters = @org.hibernate.annotations.ParamDef(name = \"orgUnitIds\", type = java.util.UUID.class)\n)",
      "source_hash": "4e066cbba8f2d7687fc07265e9612dd51063755c198ed9756ad4db3e77e1201e",
      "quote_hash": "d0818b46a207bc541637cd75e9068e198b236f8a1e8a42d98ff58fffdf47b88d",
      "note": "FilterDef is defined on BaseEntity, inherited by all subclasses"
    },
    {
      "file": "src/main/java/com/hanghai/kchtg/security/aspect/DataScopeAspect.java",
      "line": 102,
      "quote": "session.enableFilter(\"orgUnitFilter\")",
      "source_hash": "be7e56f6b9cdff9b5e0dd5ab13cf1522b4b3b43e3f73560cf8e04c9afaad55f9",
      "quote_hash": "63441e123769c9c2726154c3d9558c45077d751bf6c892a57334d03c128fd8ae",
      "note": "Aspect enables the filter but Hibernate only applies WHERE clause to entities with @Filter annotation"
    },
    {
      "file": "src/main/java/com/hanghai/kchtg/port/entity/Port.java",
      "line": 34,
      "quote": "@org.hibernate.annotations.Filter(name = \"orgUnitFilter\", condition = \"org_unit_id IN (:orgUnitIds)\")",
      "source_hash": "e87eadd7580bbe9cbaed0f1c4963b74a17e099308777828b304afe981684c021",
      "quote_hash": "7824d04546c8d497e97182a99f2183037bf7426a8fd5e3de0050f3f4cb47b11b",
      "note": "Only Port has @Filter; 8 other entities with orgUnitId are missing it"
    }
