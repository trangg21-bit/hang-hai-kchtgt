  "providers": {
    "etc-ai": {
      "name": "ETC AI",
      "env": [
        "ETC_AI_API_KEY"
      ],
      "api": {
        "type": "aisdk",
        "package": "@ai-sdk/openai-compatible",
        "url": "https://vllm.etc.vn/v1",
        "settings": {
          "baseURL": "https://vllm.etc.vn/v1"
        }
      },
      "models": {
        "ETC AI": {
          "name": "ETC AI",
          "family": "qwen",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "routing": {
            "schema_version": "ai-platform.model-routing-profile/v1",
            "quality_class": "standard",
            "latency_class": "interactive",
            "privacy_classes": [
              "workspace"
            ],
            "budget_class": "economy",
            "structured_output": false,
            "priority": 30,
            "configured_variant": "standard"
          },
          "variants": [
            {
              "id": "standard",
              "body": {
                "reasoningLevel": "standard"
              }
            },
            {
              "id": "think",
              "body": {
                "reasoningLevel": "think"
              }
            }
          ],
          "variant_strategy": "replace",
          "limit": {
            "context": 262144,
            "output": 8192
          }
        }
      }
    },
    "deepseek": {
      "name": "ETC AI",
      "env": [
        "DEEPSEEK_API_KEY"
      ],
      "api": {
        "type": "aisdk",
        "package": "@ai-sdk/openai-compatible",
        "url": "https://api.deepseek.com"
      },
      "models": {
        "deepseek-v4-pro": {
          "name": "ETC AI Pro",
          "family": "deepseek",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "routing": {
            "schema_version": "ai-platform.model-routing-profile/v1",
            "quality_class": "apex",
            "latency_class": "standard",
            "privacy_classes": [
              "workspace"
            ],
            "budget_class": "premium",
            "structured_output": false,
            "priority": 10,
            "configured_variant": "xhigh"
          },
          "variants": [
            {
              "id": "standard",
              "body": {
                "reasoningLevel": "standard"
              }
            },
            {
              "id": "think",
              "body": {
                "reasoningLevel": "think"
              }
            },
            {
              "id": "xhigh",
              "body": {
                "reasoningLevel": "xhigh"
              }
            }
          ],
          "variant_strategy": "replace",
          "limit": {
            "context": 1000000,
            "output": 384000
          }
        },
        "deepseek-v4-flash": {
          "name": "ETC AI Flash",
          "family": "deepseek",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "routing": {
            "schema_version": "ai-platform.model-routing-profile/v1",
            "quality_class": "advanced",
            "latency_class": "interactive",
            "privacy_classes": [
              "workspace"
            ],
            "budget_class": "standard",
            "structured_output": false,
            "priority": 20,
            "configured_variant": "think"
          },
          "variants": [
            {
              "id": "standard",
              "body": {
                "reasoningLevel": "standard"
              }
            },
            {
              "id": "think",
              "body": {
                "reasoningLevel": "think"
              }
            }
          ],
          "variant_strategy": "replace",
          "limit": {
            "context": 1000000,
            "output": 384000
          }
        },
        "deepseek-reasoner": {
          "family": "deepseek",
          "name": "ETC AI Reasoner"
        },
        "deepseek-chat": {
          "family": "deepseek",
          "name": "ETC AI Chat"
        }
      }
    }
  },
  "$schema": "https://ai-studio.local/config.json",
  "shell": "powershell",
  "sdlc_strict_intake": false,
  "sdlc_fail_closed": false,
  "client_preferences": {
    "general": {
      "release_notes": true,
      "followup": "steer",
      "show_file_tree": true,
      "show_search": false,
      "show_status": false,
      "show_terminal": false,
      "shell_tool_parts_expanded": false,
      "edit_tool_parts_expanded": false,
      "show_session_progress_bar": true,
      "density": "comfortable",
      "focus_mode": false,
      "stream_reveal_speed": "brisk",
      "chat_rendering_profile": "balanced",
      "mascot_color": "blackpink",
      "mascot_brain": true,
      "mascot_chattiness": "medium",
      "mascot_banter": true,
      "mascot_memory_share": true,
      "mascot_reflection": true
